,CAAA;AACA;AACA;AACA;AACA,OAjBA,MAiBA,IAAA,SAAA,IAAA,CAAA,EAAA;AAAA;AACA,aAAA,IAAA,GAAA,GAAA,CAAA,EAAA,GAAA,GAAA,WAAA,CAAA,MAAA,EAAA,GAAA,EAAA,EAAA;AACA,cAAA,GAAA,IAAA,CAAA,EAAA;AACA,YAAA,QAAA,CAAA,IAAA,CAAA,WAAA,WAAA,CAAA,GAAA,CAAA,cAAA,GAAA,GAAA,CAAA,GAAA,CAAA,CAAA;AACA,WAFA,MAEA;AACA,YAAA,QAAA,CAAA,IAAA,CAAA,WAAA,WAAA,CAAA,GAAA,CAAA,cAAA,GAAA,GAAA,CAAA,GAAA,CAAA,CAAA;AACA;AACA;;AACA,QAAA,QAAA,CAAA,IAAA,CAAA,CAAA,MAAA,EAAA,CAAA,CAAA;AACA;;AACA,aAAA,QAAA;AACA,KAlEA;AAmEA,IAAA,SAnEA,qBAmEA,KAnEA,EAmEA;AACA,UAAA,KAAA,EAAA;AACA,YAAA,KAAA,GAAA,IAAA,KAAA,CAAA,KAAA,CAAA;AACA,QAAA,KAAA,CAAA,IAAA;AACA;AACA,KAxEA;AAyEA,IAAA,MAzEA,oBAyEA;AAAA;;AACA,WAAA,MAAA,GAAA,EAAA;AACA,WAAA,UAAA,GAAA,CAAA,CAFA,CAEA;;AACA,UAAA,KAAA,UAAA,IAAA,CAAA,EAAA,KAAA,UAAA;;AAEA,UAAA,KAAA,MAAA,CAAA,MAAA,CAAA,IAAA,EAAA;AACA,aAAA,UAAA,GAAA,KAAA,MAAA,CAAA,MAAA,CAAA,IAAA;AACA;;AACA,UAAA,KAAA,GAAA,OAAA,CAAA,SAAA,CAAA,SAAA,CAAA,eAAA,CAAA,KAAA,UAAA,EAAA,IAAA,CAAA;AACA,UAAA,QAAA,GAAA,EAAA;;AAEA,UAAA,KAAA,UAAA,EAAA;AACA,YAAA,CAAA,QAAA,CAAA,KAAA,UAAA,CAAA,IAAA,KAAA,CAAA,MAAA,IAAA,CAAA,EAAA;AAAA;AACA,eAAA,QAAA,GAAA,KAAA;AACA,UAAA,QAAA,GAAA,KAAA,CAAA,CAAA,CAAA;AACA,SAHA,MAGA;AACA,UAAA,QAAA,GAAA,KAAA,UAAA;AACA;;AACA,QAAA,KAAA,CAAA,GAAA,iCAAA,kBAAA,CAAA,QAAA,CAAA,GAAA;AAAA,UAAA,MAAA,EAAA;AAAA,YAAA,IAAA,EAAA,KAAA,UAAA;AAAA,YAAA,KAAA,EAAA,KAAA;AAAA;AAAA,SAAA,EACA,IADA,CACA,UAAA,GAAA,EAAA;AACA,cAAA,GAAA,CAAA,IAAA,CAAA,MAAA,GAAA,CAAA,EAAA;AACA,YAAA,MAAA,CAAA,KAAA,GAAA,GAAA,CAAA,IAAA;AACA,WAFA,MAEA;AACA,YAAA,MAAA,CAAA,MAAA,CAAA,IAAA,CAAA,KAAA;AACA;AACA,SAPA;AAQA;AACA,KApGA;AAqGA,IAAA,YArGA,0BAqGA;AACA,WAAA,OAAA,CAAA,IAAA,YAAA,kBAAA,CAAA,KAAA,UAAA,CAAA,GAAA,KAAA,CAAA,UAAA,GAAA,EAAA,CAAA,CAAA;AACA,KAvGA;AAwGA,IAAA,KAxGA,mBAwGA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,GAAA,EAAA,KAAA,CAAA,UAAA,GAAA,EAAA,CAAA,CAAA;AAAA;AACA,WAAA,KAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,EAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,KA7GA;AA8GA,IAAA,UA9GA,wBA8GA;AACA,WAAA,KAAA,CAAA,MAAA,CAAA,KAAA;AACA,KAhHA;AAiHA,IAAA,gBAjHA,4BAiHA,GAjHA,EAiHA;AACA,UAAA,GAAA,GAAA,qDAAA,CADA,CACA;;AACA,UAAA,MAAA,GAAA,GAAA,CAAA,KAAA,CAAA,GAAA,CAAA;AACA,UAAA,QAAA,GAAA,EAAA;;AACA,UAAA,MAAA,EAAA;AACA,QAAA,QAAA,GAAA,GAAA,CAAA,OAAA,CAAA,GAAA,EAAA,UAAA,CAAA,CADA,CACA;AACA,OAFA,MAEA;AACA,QAAA,QAAA,GAAA,GAAA;AACA;;AACA,aAAA,QAAA;AACA;AA3HA;AAvFA,CAAA","sourcesContent":["<template>\n  <div class=\"home\">\n    <div class=\"container-fluid\">\n    <div class=\"row\">\n      <div class=\"col-lg-3\"></div>\n        <div class=\"col-lg\">\n          <h3 class=\"my-3 noselect\" @click=\"clear()\" unselectable=\"on\">Tsuginoji 次の字</h3>\n          <div class=\"input-group mb-3\">\n            <input type=\"text\" ref=\"search\" autocomplete=\"on\" class=\"form-control\" placeholder=\"漢字・仮名・ローマ字\" aria-label=\"search\" aria-describedby=\"basic-addon2\" v-model=\"searchWord\" @keyup.enter=\"redirectPage\" @focus=\"$event.target.select()\">\n            <div class=\"input-group-append\">\n              <button class=\"btn btn-outline-secondary\" type=\"button\" @click=\"redirectPage\">項目を検索</button>\n            </div>\n          </div>\n          <div v-show=\"sentence.length > 0\" transition=\"expand\">\n            <transition-group name=\"slide-fade\" mode=\"out-in\">\n            <div v-for=\"(word, index) in sentence\" :key=index class=\"wordBlock mr-2\">\n              {{word}}\n            </div>\n            </transition-group>\n            <button type=\"button\" class=\"close\" aria-label=\"Close\" v-show=\"sentence\" @click=\"sentence = []\">\n              <span aria-hidden=\"true\">&times;</span>\n            </button>\n          </div>\n              <toggle-button class=\"float-right\" v-model=\"autoSearch\" :sync=\"true\"\n          :labels=\"{checked: '自動検索', unchecked: '自動検索'}\" :width=\"75\" :class=\"{ 'mt-2': sentence }\"/>            \n          <div v-show=\"words.length > 0 && errors.length == 0\" v-infinite-scroll=\"loadMore\"\n              infinite-scroll-disabled=\"busy\"\n              infinite-scroll-distance=\"500\"\n              class=\"mt-2\">\n            <transition-group name=\"slide-fade\" mode=\"out-in\">\n            <div v-for=\"word in words\"\n                  :key=\"word._id\"\n                  :id=\"word._id\">\n              <div class=\"my-4 word\">\n                <div class=\"wordBlock mr-2\">\n                <h2 class=\"word-title\">{{word.word}}</h2>\n                <svg @click.prevent=\"playSound(word.audio)\" v-if=\"word.audio\" width=\"1em\" height=\"1em\" viewBox=\"0 0 16 16\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\">\n                  <path d=\"M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z\"/>\n                </svg>\n                </div>\n                <p v-html=\"formatDefinition(word.definition)\" class=\"definition\"></p>\n                <div v-if=\"word.pitch\">\n                  <div v-for=\"pitch in word.pitch\" :key=\"pitch\" class=\"wordBlock mr-5\">\n                    <line-chart :legend=\"false\" label=\"Value\" :data=\"createAccent(word.kana, pitch)\" :library=\"chartOptions\" :style=\"styleChart(word.kana)\" :colors=\"['#b00']\"></line-chart>\n                    <p>{{pitch}}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n            </transition-group>        \n          </div>\n          <transition name=\"slide-fade\" mode=\"out-in\">\n          <div v-show=\"words.length == 0 && $route.name == 'Home'\">\n            <ul>\n              <li>「Ｆ」を押すと入力</li>\n              <li>「Ｄ」を押すと自動検索のオンオフ切り替えができます</li>\n              <li>自動検索がオフになっている場合、単語や文章をセレクトして「Ｓ」を押すとその単語を調べられます</li>\n            </ul>\n          </div>\n          </transition>\n          <transition name=\"slide-fade\" mode=\"out-in\">\n          <div v-show=\"$route.name != 'Home' && this.errors.length > 0\">\n            <h3 class=\"word-title\">４０４エラー</h3>\n            <p class=\"definition\"> その単語を見つけられません。(〃∀〃)ゞ</p>\n          </div>\n          </transition>\n        </div>\n        <div class=\"col-lg-3\"></div>\n    </div>\n  </div>\n</div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport natural from \"natural\";\nimport {isRomaji, isKanji, isKatakana, isHiragana} from \"wanakana\";\nimport Chart from 'chart.js';\n\nexport default {\n  name: 'Home',\n  data() {\n    return {\n      pageNumber: 0,\n      limit: 20,\n      searchWord: '',\n      words: [],\n      errors: [],\n      sentence: [],\n      autoSearch: false,\n      chartOptions: {\n        devicePixelRatio: 4,\n        responsive: true, \n        maintainAspectRatio: false,\n        showTooltips: true,\n        // events: [], turn off info over hover\n        scales: {\n          yAxes: [{\n            display: false // this hides the y-axis in the linechart\n          }],\n          xAxes: [{\n            display: true,\n            ticks: {\n              userCallback: function(label, index, labels) {\n                return label.split('-')[0]\n              },\n            }\n          }]\n        },\n        layout: {\n          padding: {\n            top: 5\n          }\n      },\n    }\n    }\n  }, \n  watch: {\n  '$route' () {\n    if (this.$route.name == 'Home') { // when user uses history to go back to home\n      this.words = [];\n      this.sentence = [];\n      this.searchWord = '';\n    }\n    this.search();\n  },\n  'autoSearch' () {\n    localStorage.setItem('autoSearch', this.autoSearch); // remember user's choices\n  }\n},\n  mounted() {\n    if (this.$route.params.word && this.words.length == 0) { // user navigated to page manually/refreshed\n      this.searchWord = this.$route.params.word;\n      this.search();\n    }\n\n    if (localStorage.getItem('autoSearch')) {\n      this.autoSearch = (localStorage.getItem('autoSearch') == 'true');\n    }\n\n    let self = this; \n\n    window.addEventListener('keyup', function(ev) {\n        if (ev.which == 70) { // if user presses 'f', focus on input\n          self.focusInput();\n        }\n\n        if (ev.which == 68 && ev.path[0].localName != 'input') { // if user presses 'd', toggle on/off autosearch button\n          self.autoSearch = !self.autoSearch;\n        } \n\n        if (ev.which == 83 && !self.autoSearch && ev.path[0].localName != 'input' && window.getSelection().toString() != '') { // if user presses 's' and autosearch is off, search highlighted word\n          self.searchWord = window.getSelection().toString(); \n          self.$router.push(`/${encodeURIComponent(self.searchWord)}`).catch((err) => {});\n          window.scrollTo(0,0);\n        }\n    });\n\n    window.addEventListener('mouseup', function(ev) { // on select/highlight\n        if(window.getSelection().toString() && ev.path[0].localName != 'input' && self.autoSearch){\n          self.searchWord = window.getSelection().toString();  \n          self.$router.push(`/${encodeURIComponent(self.searchWord)}`).catch((err) => {});\n          window.scrollTo(0,0);\n      }\n    });\n  },\n  methods: {\n    styleChart(kana) {\n      let style = 'height: 60px; max-width:'\n      if (kana.length <= 2) {\n        return `${style} 130px`\n      } else if (kana.length <= 5) {\n        return `${style} 200px;`;\n      } else if (kana.length < 8) {\n        return `${style} 350px;`;\n      } else {\n        return `${style} 3000px;`;\n      }\n    },\n     loadMore() {\n      this.pageNumber++;\n      this.busy = true;\n      if (this.searchWord) {\n        axios.get(`http://localhost:5000/${encodeURIComponent(this.searchWord)}`, { params: { page: this.pageNumber, limit: this.limit } })\n        .then((res) => {\n          this.words = this.words.concat(res.data); \n          this.busy = false;\n        });\n      }\n    },\n    createAccent(kana, accent) {\n      const sokuon = ['ぁ', 'ァ', 'ぃ', 'ィ', 'ぅ', 'ゥ', 'ぇ', 'ェ', 'ぉ', 'ォ', 'ゃ', 'ャ', 'ゅ', 'ュ', 'ょ', 'ョ'];\n      let accentStr = accent.replace('[', '').replace(']', '');\n      let kanaArr = kana.split('');\n      let xAxisLabels = []\n      for (let i =0; i < kanaArr.length; i++) { // create x axis labels, combining any sokuon that was separated from .split('')\n        if (!sokuon.includes(kanaArr[i])) { // not sokuon\n          xAxisLabels.push(kanaArr[i])\n        } else { // combine the sokuon with the previous element\n          xAxisLabels[xAxisLabels.length - 1] = xAxisLabels[xAxisLabels.length - 1] + kanaArr[i]; \n        }\n      }\n\n      let xAxisArr = []\n      if (accentStr == 0 || accentStr != 1) { //draw everything heiban, even nakadaka and odaka words\n        for (let i = 0; i < xAxisLabels.length; i++) {\n          if (i == 0) {\n            xAxisArr.push([`${xAxisLabels[i]}-${i+1}`, 0])\n          } else {\n            xAxisArr.push([`${xAxisLabels[i]}-${i+1}`, 1])\n          }\n        }\n        xAxisArr.push(['(助詞)', 1]) // add particle at the end\n        \n        if (accentStr != 0) { // if not heiban (nakadaka, odaka), make other pitch at and after accent low\n          if (xAxisArr[parseInt(accentStr)]) {\n            for (let i = parseInt(accentStr); i < xAxisArr.length; i++) {\n              xAxisArr[i][1] = 0;\n            }\n          }\n        }\n      } else if (accentStr == 1) { // atamadaka\n          for (let i = 0; i < xAxisLabels.length; i++) {\n          if (i == 0) {\n            xAxisArr.push([`${xAxisLabels[i]}-${i+1}`, 1])\n          } else {\n            xAxisArr.push([`${xAxisLabels[i]}-${i+1}`, 0])\n          }\n        }\n        xAxisArr.push(['(助詞)', 0])\n      }\n      return xAxisArr\n    },\n    playSound (sound) {\n      if(sound) {\n        const audio = new Audio(sound);\n        audio.play();       \n      }\n    },\n    search() {\n      this.errors = [];\n      this.pageNumber = 0; // reset page number on search\n      if (this.pageNumber == 0) this.pageNumber++;\n\n      if (this.$route.params.word) {\n              this.searchWord = this.$route.params.word;\n      }\n            let token = natural.StemmerJa.prototype.tokenizeAndStem(this.searchWord, true);\n            let toSearch = '';\n\n            if (this.searchWord) {\n              if (!isRomaji(this.searchWord) && token.length >= 2) { // check if input is a sentence\n              this.sentence = token;\n              toSearch = token[0];\n            } else {\n              toSearch = this.searchWord;\n            }\n            axios.get(`http://localhost:5000/${encodeURIComponent(toSearch)}`, { params: { page: this.pageNumber, limit: this.limit } })\n                  .then((res) => {\n                    if (res.data.length > 0 ) {\n                      this.words = res.data;\n                    } else {\n                      this.errors.push('404');\n                    }\n              })\n            }\n    },\n    redirectPage() {\n      this.$router.push(`/${encodeURIComponent(this.searchWord)}`).catch((err) => {});\n    },\n    clear() {\n      this.$router.push('/').catch((err) => {});;\n      this.words = [];\n      this.sentence = [];\n      this.searchWord = '';\n    },\n    focusInput(){\n      this.$refs.search.focus();\n    },\n    formatDefinition(def) {\n      let reg = /(\\uFF08[\\uFF10-\\uFF19]+\\uFF09)(?![^{]*})(?![^〔]*〕)/g // gets the japanese numbers and ignores brackets\n      const numArr = def.match(reg);\n      let finalDef = '';\n      if (numArr) {\n        finalDef = def.replace(reg, '<br/> $&'); // add a line break at where the definition listings occur\n      } else {\n        finalDef = def;\n      }\n      return finalDef;\n    }\n  }\n};\n</script>\n\n<style scoped>\n@import '../assets/css/styles.css';\n\n .small {\n    max-width: 600px;\n    margin:  150px auto;\n  }\n</style>"],"sourceRoot":"src/components"}]}